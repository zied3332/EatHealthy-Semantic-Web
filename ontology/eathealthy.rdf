    <!-- BEGIN module aliments (Mahdi) -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#valeurImpact">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#valeurEnvironnementale"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#ImpactEnvironnemental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="fr">valeur de l'impact</rdfs:label>
        <rdfs:comment xml:lang="fr">Valeur d'une empreinte : kg CO2e par kg d'aliment (EmpreinteCarbone) ou litres par kg (EmpreinteEau).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#uniteImpact">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#ImpactEnvironnemental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">unité de l'impact</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#sourceImpact">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#ImpactEnvironnemental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="fr">source de l'impact</rdfs:label>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#estImpactDe">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#aImpact"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#ImpactEnvironnemental"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Aliment"/>
        <rdfs:label xml:lang="fr">est l'impact de</rdfs:label>
    </owl:ObjectProperty>

    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#aCalories">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </rdf:Description>

    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#prixMoyen">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </rdf:Description>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Fruit"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Legume"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Cereale"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Viande"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Poisson"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#ProduitLaitier"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#EmpreinteCarbone">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#EmpreinteEau"/>
    </rdf:Description>

    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Aliment">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#ImpactEnvironnemental"/>
    </rdf:Description>

    <owl:Class rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#AlimentFaibleCarbone">
        <rdfs:label xml:lang="fr">Aliment à faible empreinte carbone</rdfs:label>
        <rdfs:comment xml:lang="fr">Aliment dont l'empreinte carbone est inférieure ou égale à 2 kg CO2e par kg.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Aliment"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#aImpact"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#EmpreinteCarbone"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#valeurImpact"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</xsd:maxInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#AlimentFortCarbone">
        <rdfs:label xml:lang="fr">Aliment à forte empreinte carbone</rdfs:label>
        <rdfs:comment xml:lang="fr">Aliment dont l'empreinte carbone est supérieure ou égale à 10 kg CO2e par kg.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#Aliment"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#aImpact"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#EmpreinteCarbone"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#valeurImpact"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#AlimentDurable">
        <rdfs:label xml:lang="fr">Aliment durable</rdfs:label>
        <rdfs:comment xml:lang="fr">Aliment à faible empreinte carbone et produit localement.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#AlimentFaibleCarbone"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/thinkpad/ontologies/2026/9/EatHealthy#estLocal"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- END module aliments (Mahdi) -->

</rdf:RDF>